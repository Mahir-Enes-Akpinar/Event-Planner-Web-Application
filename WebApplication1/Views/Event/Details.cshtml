@model WebApplication1.Models.Etkinlik
@inject IConfiguration Configuration
@using System.Security.Claims
@using System.Text.Json
@{
    ViewData["Title"] = Model.Name;
    Layout = "~/Views/Shared/UserLayout.cshtml";
    var userId = int.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier)!);
    var participation = Model.Participants.FirstOrDefault(item => item.KullaniciId == userId);
    var isOwner = Model.CreatedByUserId == userId || User.IsInRole("Admin");
    var registeredCount = Model.Participants.Count(item => item.Status == ParticipationStatus.Registered);
    var eventEnded = Model.Date.Add(Model.Duration) <= DateTime.Now;
}
<link rel="stylesheet" href="~/vendor/leaflet/leaflet.css">
<style>
    .details-shell{display:grid;gap:22px}
    .details-hero{overflow:hidden;display:grid;grid-template-columns:minmax(280px,.9fr) 1.1fr;gap:0;border:1px solid rgba(255,255,255,.78);border-radius:30px;background:rgba(255,255,255,.66);box-shadow:0 26px 70px rgba(51,35,114,.13);backdrop-filter:blur(22px)}
    .details-cover{width:100%;height:100%;min-height:390px;object-fit:cover}
    .details-copy{padding:30px;display:flex;flex-direction:column;gap:18px}
    .details-copy h1{margin:0;font-weight:900;letter-spacing:-.055em;line-height:1}
    .details-description{color:var(--muted);font-size:1rem;line-height:1.6}
    .meta-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
    .meta-card{padding:14px;border:1px solid rgba(232,229,245,.85);border-radius:18px;background:rgba(255,255,255,.74)}
    .meta-card span{display:block;color:var(--muted);font-size:.78rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em}.meta-card strong{display:block;margin-top:4px;color:var(--navy)}
    .status-row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.soft-pill{display:inline-flex;align-items:center;min-height:34px;padding:0 12px;border-radius:999px;background:#fff1f2;color:#e11d48;font-weight:850}.owner-pill{background:#eefdfb;color:#0f766e}
    .action-panel{display:flex;gap:12px;flex-wrap:wrap;margin-top:auto}
    .details-card{padding:22px;border:1px solid rgba(255,255,255,.78);border-radius:26px;background:rgba(255,255,255,.66);box-shadow:0 22px 54px rgba(51,35,114,.1);backdrop-filter:blur(20px)}
    #map{height:360px;border:2px solid #e7e0ff;border-radius:20px;box-shadow:0 14px 30px rgba(51,35,114,.08)}
    .community-head{display:flex;align-items:end;justify-content:space-between;gap:16px;margin-bottom:16px}
    .community-head h2{margin:0;font-weight:900;letter-spacing:-.04em}.community-head p{margin:4px 0 0;color:var(--muted)}
    .message-list{display:grid;gap:12px;margin-bottom:18px}
    .community-message{position:relative;padding:16px;border:1px solid rgba(232,229,245,.95);border-radius:20px;background:rgba(255,255,255,.78)}
    .community-message.pinned{border-color:rgba(255,183,3,.55);background:linear-gradient(135deg,#fff7ed,rgba(255,255,255,.86))}
    .message-top{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}
    .message-author{display:flex;align-items:center;gap:10px;font-weight:850}
    .avatar-dot{display:grid;place-items:center;width:38px;height:38px;border-radius:14px;color:#fff;background:linear-gradient(145deg,var(--primary),var(--accent));font-weight:900}
    .role-badge,.pin-badge{display:inline-flex;align-items:center;min-height:24px;padding:0 9px;border-radius:999px;font-size:.74rem;font-weight:850}
    .role-badge{background:#eef2ff;color:#4f46e5}.pin-badge{background:#fff7ed;color:#c2410c}
    .message-content{margin:12px 0;color:#26314d;line-height:1.6;white-space:pre-wrap}.message-time{color:var(--muted);font-size:.82rem}
    .pin-button{border:1px solid #eee7ff;border-radius:10px;background:#fff;color:#59657b;padding:7px 10px;font-weight:800}
    .pin-button:hover{color:#e11d48;background:#fff1f2}
    .comment-box textarea{min-height:120px;border-color:#e4ddf5;border-radius:16px;background:rgba(255,255,255,.86)}
    @@media(max-width:900px){.details-hero{grid-template-columns:1fr}.details-cover{max-height:360px}.meta-grid{grid-template-columns:1fr}}
</style>
<main class="details-shell">
    @if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success" role="status">@success</div> }
    @if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }

    <section class="details-hero">
        <img class="details-cover" src="@(Model.ImageUrl ?? "/images/default-event.jpg")" alt="@Model.Name">
        <div class="details-copy">
            <div>
                <div class="eyebrow">Etkinlik Detayı</div>
                <h1>@Model.Name</h1>
            </div>
            <p class="details-description">@(string.IsNullOrWhiteSpace(Model.Description) ? "Bu etkinlik için henüz açıklama eklenmemiş." : Model.Description)</p>
            <div class="status-row">
                <span class="soft-pill">@Model.Status</span>
                <span class="soft-pill owner-pill">Kurucu: @(Model.CreatedByUser?.UserName ?? "Bilinmiyor")</span>
            </div>
            <div class="meta-grid">
                <div class="meta-card"><span>Tarih</span><strong>@Model.Date.ToString("dd MMMM yyyy HH:mm")</strong></div>
                <div class="meta-card"><span>Süre</span><strong>@($"{(int)Model.Duration.TotalHours} saat {Model.Duration.Minutes} dk")</strong></div>
                <div class="meta-card"><span>Adres</span><strong>@Model.Location</strong></div>
                <div class="meta-card"><span>Katılım</span><strong>@registeredCount kişi@(Model.MaxParticipants is > 0 ? $" / {Model.MaxParticipants} kontenjan" : "")</strong></div>
            </div>
            <div class="action-panel">
                @if (!isOwner && Model.Status == EventStatus.Approved && Model.Date > DateTime.Now)
                {
                    if (participation?.Status == ParticipationStatus.Registered)
                    {
                        <form asp-action="LeaveEvent" method="post"><input type="hidden" name="etkinlikId" value="@Model.Id"><button class="btn btn-outline-danger" type="submit">Katılımdan ayrıl</button></form>
                    }
                    else
                    {
                        <form asp-action="JoinEvent" method="post"><input type="hidden" name="EtkinlikId" value="@Model.Id"><button class="btn-primary-modern" type="submit">Katıl</button></form>
                    }
                }
            </div>
        </div>
    </section>

    <section class="details-card">
        <div class="community-head">
            <div><h2>Konum</h2><p id="mapHint">Etkinlik adresini haritada görüntüle.</p></div>
        </div>
        <div id="map" aria-label="Etkinlik konumu"></div>
    </section>

    @if (isOwner && eventEnded && Model.Status == EventStatus.Approved)
    {
        <section class="details-card">
            <div class="community-head"><div><h2>Katılımı doğrula</h2><p>Etkinlik sonrası yoklamayı tamamla.</p></div></div>
            <form asp-action="ConfirmAttendance" method="post">
                <input type="hidden" name="eventId" value="@Model.Id">
                <div class="row g-2">
                    @foreach (var attendee in Model.Participants.Where(item => item.Status == ParticipationStatus.Registered))
                    {
                        <div class="col-md-4"><div class="form-check"><input class="form-check-input" type="checkbox" name="attendedUserIds" value="@attendee.KullaniciId" id="attendee-@attendee.KullaniciId"><label class="form-check-label" for="attendee-@attendee.KullaniciId">@attendee.Kullanici.UserName</label></div></div>
                    }
                </div>
                <button class="btn-primary-modern mt-3" type="submit">Yoklamayı tamamla</button>
            </form>
        </section>
    }

</main>

@section Scripts {
    <script src="~/vendor/leaflet/leaflet.js"></script>
    <script>
        const eventAddress = @Html.Raw(JsonSerializer.Serialize(Model.Location ?? ""));
        const savedLocation = [
            @Model.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture),
            @Model.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture)
        ];
        const hasSavedLocation = savedLocation[0] !== 0 || savedLocation[1] !== 0;
        const mapHint = document.getElementById('mapHint');
        const defaultTurkeyCenter = [39.0, 35.0];
        const map = L.map('map').setView(hasSavedLocation ? savedLocation : defaultTurkeyCenter, hasSavedLocation ? 14 : 6);
        L.tileLayer('/map-tiles/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors',
            maxZoom: 19
        }).addTo(map);

        let eventMarker = null;
        const setEventMarker = (point, zoom = 14) => {
            eventMarker = eventMarker || L.marker(point).addTo(map);
            eventMarker.setLatLng(point);
            map.setView(point, zoom);
        };

        if (hasSavedLocation) {
            setEventMarker(savedLocation);
        } else if (eventAddress.trim().length >= 3) {
            mapHint.textContent = 'Kayıtlı koordinat yok; adres üzerinden yaklaşık konum aranıyor.';
            fetch(`/api/locations/search?q=${encodeURIComponent(eventAddress)}`)
                .then(response => response.ok ? response.json() : [])
                .then(results => {
                    const firstResult = results && results[0];
                    if (!firstResult) {
                        mapHint.textContent = 'Bu adres için harita konumu bulunamadı. Etkinliği düzenleyip haritadan nokta seçebilirsin.';
                        return;
                    }

                    setEventMarker([firstResult.latitude, firstResult.longitude]);
                    mapHint.textContent = firstResult.displayName || 'Adres haritada yaklaşık olarak gösteriliyor.';
                })
                .catch(() => {
                    mapHint.textContent = 'Adres haritada bulunamadı. Etkinliği düzenleyip haritadan nokta seçebilirsin.';
                });
        } else {
            mapHint.textContent = 'Bu etkinlik için kayıtlı adres/koordinat yok.';
        }

        setTimeout(() => map.invalidateSize(), 150);
    </script>
}
