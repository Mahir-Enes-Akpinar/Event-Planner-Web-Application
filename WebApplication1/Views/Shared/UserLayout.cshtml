<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#6d5dfc">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="Etkinlik">
    <title>@ViewData["Title"] - Etkinlik Platformu</title>
    <link rel="manifest" href="~/manifest.webmanifest">
    <link rel="apple-touch-icon" href="~/images/logo.png">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/style2.css">
    <style>
        :root { --navy:#151b2d; --primary:#6d5dfc; --accent:#ff6b6b; --teal:#0fb9b1; --sun:#ffb703; --soft:#f7f5ff; --muted:#6d7488; --line:#e8e5f5; }
        body { color:var(--navy); background:linear-gradient(135deg,#fff7ed 0%,#f7f5ff 38%,#edfaff 100%); }
        .app-nav { position:sticky; top:0; z-index:1000; border-bottom:1px solid rgba(232,229,245,.85); background:rgba(255,255,255,.88); backdrop-filter:blur(16px); box-shadow:0 10px 30px rgba(51,35,114,.06); }
        .app-nav-inner { width:min(1200px,calc(100% - 32px)); min-height:76px; margin:auto; display:flex; align-items:center; gap:28px; }
        .app-brand { display:flex; align-items:center; gap:10px; color:var(--navy); font-weight:800; text-decoration:none; white-space:nowrap; }
        .app-brand-mark { display:grid; place-items:center; width:38px; height:38px; border-radius:12px; color:#fff; background:linear-gradient(145deg,var(--primary),var(--accent)); box-shadow:0 10px 22px rgba(109,93,252,.28); }
        .app-links { display:flex; align-items:center; gap:4px; flex:1; min-width:0; overflow-x:auto; scrollbar-width:none; }
        .app-links::-webkit-scrollbar{display:none}
        .app-links a { display:inline-flex; align-items:center; flex:0 0 auto; gap:8px; padding:10px 12px; border-radius:10px; color:#5d6578; font-size:.88rem; font-weight:650; text-decoration:none; white-space:nowrap; transition:color .2s,background .2s,transform .2s; }
        .app-links a:hover,.app-links a.active { color:#4f46e5; background:linear-gradient(135deg,#fff1f2,#eef2ff); transform:translateY(-1px); }
        .app-user { display:flex; align-items:center; gap:10px; color:var(--navy); font-size:.84rem; font-weight:700; }
        .app-avatar,.app-avatar-icon { width:40px; height:40px; border:2px solid #fff; border-radius:50%; box-shadow:0 0 0 3px #efeaff; }
        .app-avatar { object-fit:cover; }
        .app-avatar-icon { display:grid; place-items:center; color:#fff; background:linear-gradient(145deg,var(--primary),var(--accent)); font-size:1.05rem; font-weight:900; }
        .app-menu { position:relative; flex:0 0 auto; }
        .app-menu summary { display:flex; align-items:center; gap:10px; cursor:pointer; list-style:none; }
        .app-menu summary::-webkit-details-marker { display:none; }
        .app-dropdown { position:absolute; right:0; top:52px; min-width:190px; padding:8px; border:1px solid var(--line); border-radius:14px; background:#fff; box-shadow:0 16px 40px rgba(51,35,114,.14); }
        .app-dropdown a,.app-dropdown button { display:block; width:100%; padding:10px 12px; border:0; border-radius:9px; color:#59657b; background:transparent; font:inherit; text-align:left; text-decoration:none; }
        .app-dropdown a:hover,.app-dropdown button:hover { background:#fff1f2; color:#e11d48; }
        .main-content { width:min(1200px,calc(100% - 32px)); margin:auto; padding:34px 0 60px; }
        .page-heading { display:flex; align-items:end; justify-content:space-between; gap:20px; margin-bottom:24px; }
        .page-heading h1 { margin:0; font-size:clamp(1.7rem,3vw,2.5rem); letter-spacing:-.045em; }
        .page-heading p { margin:7px 0 0; color:var(--muted); }
        .surface { border:1px solid rgba(232,229,245,.95); border-radius:20px; background:rgba(255,255,255,.94); box-shadow:0 14px 34px rgba(51,35,114,.07); }
        .event-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(245px,1fr)); gap:18px; }
        .event-card { overflow:hidden; display:flex; flex-direction:column; border:1px solid rgba(232,229,245,.95); border-radius:18px; background:#fff; box-shadow:0 10px 28px rgba(51,35,114,.07); transition:transform .2s,box-shadow .2s,border-color .2s; }
        .event-card:hover { transform:translateY(-4px); border-color:#c7d2fe; box-shadow:0 18px 38px rgba(109,93,252,.15); }
        .event-card-image { width:100%; height:155px; object-fit:cover; }
        .event-card-body { display:flex; flex:1; flex-direction:column; padding:16px; border-top:4px solid transparent; border-image:linear-gradient(90deg,var(--accent),var(--sun),var(--teal),var(--primary)) 1; }
        .event-card h3 { margin:0 0 8px; font-size:1.03rem; }
        .event-meta { display:flex; gap:7px; margin:7px 0; color:var(--muted); font-size:.8rem; }
        .event-card-details { flex:1; margin-bottom:12px; }
        .event-card-body .btn-primary-modern { margin-top:auto !important; }
        .btn-primary-modern { display:inline-flex; align-items:center; justify-content:center; min-height:42px; padding:0 16px; border:0; border-radius:11px; color:#fff; background:linear-gradient(135deg,var(--primary),#8b5cf6 52%,var(--accent)); font-weight:700; text-decoration:none; box-shadow:0 10px 24px rgba(109,93,252,.24); transition:transform .2s,box-shadow .2s; }
        .btn-primary-modern:hover { color:#fff; transform:translateY(-1px); box-shadow:0 14px 30px rgba(255,107,107,.25); }
        @@media(max-width:820px) {
            .app-nav-inner { width:calc(100% - 20px); min-height:auto; flex-wrap:wrap; gap:10px 12px; padding:10px 0 12px; }
            .app-brand { flex:1 1 auto; min-width:0; font-size:.95rem; }
            .app-brand-mark { width:34px; height:34px; border-radius:11px; }
            .app-menu { margin-left:auto; }
            .app-user { max-width:42vw; gap:7px; font-size:.78rem; }
            .app-avatar,.app-avatar-icon { width:34px; height:34px; box-shadow:0 0 0 2px #efeaff; }
            .app-dropdown { right:0; top:44px; max-width:calc(100vw - 22px); }
            .app-links { order:3; width:100%; flex:0 0 100%; gap:8px; overflow-x:auto; overscroll-behavior-x:contain; scroll-snap-type:x proximity; padding:2px 8px 4px; margin:0 -8px; }
            .app-links a { min-height:40px; padding:9px 13px; border:1px solid rgba(232,229,245,.75); background:rgba(255,255,255,.62); scroll-snap-align:start; white-space:nowrap; }
            .main-content { width:calc(100% - 20px); padding-top:20px; }
        }
        @@media(max-width:640px) {
            .page-heading { align-items:flex-start; flex-direction:column; gap:10px; }
            .event-grid { display:flex; grid-template-columns:unset; gap:14px; overflow-x:auto; overflow-y:hidden; scroll-snap-type:x mandatory; overscroll-behavior-x:contain; margin:0 -10px; padding:4px 10px 18px; scrollbar-width:none; }
            .event-grid::-webkit-scrollbar { display:none; }
            .event-grid .event-card { flex:0 0 min(84vw,360px); max-width:min(84vw,360px); scroll-snap-align:start; }
            .event-card-image { height:150px; }
        }
        @@media(max-width:430px) {
            .app-brand span:last-child { max-width:145px; overflow:hidden; text-overflow:ellipsis; }
            .app-user { max-width:38vw; }
            .app-user-name { max-width:96px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
            .app-menu summary { max-width:44vw; overflow:hidden; }
        }
    </style>
</head>
<body>
    <nav class="app-nav" aria-label="Ana navigasyon">
        <div class="app-nav-inner">
            <a class="app-brand" asp-controller="User" asp-action="Index"><span class="app-brand-mark">✦</span><span>Etkinlik Platformu</span></a>
            <div class="app-links">
                <a asp-controller="User" asp-action="Index">Ana sayfa</a>
                <a asp-controller="Event" asp-action="AddEvent">Etkinlik oluştur</a>
                <a asp-controller="User" asp-action="MyEvent">Etkinliklerim</a>
                <a asp-controller="Event" asp-action="Map">Harita</a>
                <a asp-controller="User" asp-action="Leaderboard">Sıralama</a>
            </div>
            @{
                var profilePicture = Context.Session.GetString("UserProfilePicture");
                var hasProfilePicture = !string.IsNullOrWhiteSpace(profilePicture) && !profilePicture.Contains("default-profile", StringComparison.OrdinalIgnoreCase);
            }
            <details class="app-menu">
                <summary class="app-user">
                    @if (hasProfilePicture)
                    {
                        <img class="app-avatar" src="@profilePicture" alt="Profil">
                    }
                    else
                    {
                        <span class="app-avatar-icon" aria-hidden="true">👤</span>
                    }
                    <span class="app-user-name">@(User.Identity?.Name ?? "Kullanıcı")</span>
                </summary>
                <div class="app-dropdown">
                    <a asp-controller="User" asp-action="Profile">Profilim</a>
                    <a asp-controller="User" asp-action="SelectInterests">İlgi alanlarım</a>
                    <form asp-controller="Home" asp-action="Logout" method="post"><button type="submit">Çıkış yap</button></form>
                </div>
            </details>
        </div>
    </nav>
    <main class="main-content" id="main-content">@RenderBody()</main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function () {
                navigator.serviceWorker.register('/service-worker.js').catch(function () { });
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
