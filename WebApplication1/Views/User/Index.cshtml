@model Tuple<List<WebApplication1.Models.Etkinlik>, List<WebApplication1.Models.Etkinlik>, List<WebApplication1.Models.Etkinlik>>
@using WebApplication1.Models
@{
    ViewData["Title"] = "Keşfet";
    Layout = "~/Views/Shared/UserLayout.cshtml";
    var categories = ViewBag.Categories as IEnumerable<Kategori> ?? Enumerable.Empty<Kategori>();
    var recommendations = Model.Item1;
    var nearby = Model.Item2;
    var events = Model.Item3;
}
<style>
    .discover-hero{position:relative;overflow:hidden;display:grid;grid-template-columns:1.1fr .9fr;gap:24px;align-items:center;margin-bottom:24px;padding:32px;border:1px solid rgba(255,255,255,.76);border-radius:30px;background:linear-gradient(135deg,rgba(255,255,255,.74),rgba(255,255,255,.38));box-shadow:0 26px 70px rgba(51,35,114,.13);backdrop-filter:blur(22px)}
    .discover-hero:before{content:"";position:absolute;inset:-80px -100px auto auto;width:310px;height:310px;border-radius:50%;background:radial-gradient(circle,rgba(255,107,107,.34),transparent 66%);pointer-events:none}
    .discover-hero:after{content:"";position:absolute;inset:auto auto -110px -90px;width:260px;height:260px;border-radius:50%;background:radial-gradient(circle,rgba(15,185,177,.28),transparent 65%);pointer-events:none}
    .hero-copy{position:relative;z-index:1}.hero-copy h1{margin:0;font-size:clamp(2rem,5vw,4rem);font-weight:900;letter-spacing:-.06em;line-height:.98}.hero-copy p{max-width:620px;margin:16px 0 0;color:var(--muted);font-size:1.02rem}
    .hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:24px}.ghost-button{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:0 16px;border:1px solid rgba(109,93,252,.22);border-radius:12px;color:#4f46e5;background:rgba(255,255,255,.58);font-weight:800;text-decoration:none}
    .hero-stats{position:relative;z-index:1;display:grid;grid-template-columns:1fr 1fr;gap:14px}.stat-card{padding:18px;border:1px solid rgba(255,255,255,.78);border-radius:22px;background:rgba(255,255,255,.58);box-shadow:0 18px 38px rgba(51,35,114,.1);backdrop-filter:blur(18px)}.stat-card strong{display:block;font-size:2rem;line-height:1;color:#151b2d}.stat-card span{color:var(--muted);font-size:.86rem}
    .filter-glass{margin-bottom:34px;padding:16px;border:1px solid rgba(255,255,255,.76);border-radius:22px;background:rgba(255,255,255,.64);box-shadow:0 18px 42px rgba(51,35,114,.08);backdrop-filter:blur(18px)}
    .filter-glass .form-control,.filter-glass .form-select{border-color:#e4ddf5;border-radius:14px;background:rgba(255,255,255,.85)}
    .filter-grid{display:grid;grid-template-columns:minmax(220px,1.4fr) minmax(180px,1fr) minmax(300px,1.1fr) minmax(110px,.45fr);gap:10px;align-items:center}
    .date-range{display:grid;grid-template-columns:1fr 1fr;gap:8px;min-width:0}.filter-button{min-height:38px;padding:0 12px;font-size:.88rem;box-shadow:0 8px 18px rgba(109,93,252,.18)}
    .section-title{display:flex;align-items:end;justify-content:space-between;gap:16px;margin:32px 0 16px}.section-title h2{margin:0;font-weight:850;letter-spacing:-.035em}.section-title p{margin:4px 0 0;color:var(--muted)}
    .event-card{background:rgba(255,255,255,.75);backdrop-filter:blur(18px)}.event-card h3{line-height:1.25}.result-pill{display:inline-flex;align-items:center;min-height:34px;padding:0 12px;border-radius:999px;color:#e11d48;background:#fff1f2;font-weight:800}
    .empty-state{padding:54px 20px;text-align:center;border:1px solid rgba(255,255,255,.76);border-radius:26px;background:rgba(255,255,255,.62);backdrop-filter:blur(18px)}
    @@media(max-width:960px){.filter-grid{grid-template-columns:1fr 1fr}.date-range{grid-column:1 / -1}.filter-button{width:100%}}
    @@media(max-width:860px){.discover-hero{grid-template-columns:1fr}.hero-stats{grid-template-columns:1fr 1fr}.section-title{align-items:start;flex-direction:column}}
    @@media(max-width:560px){
        .discover-hero{padding:22px 18px;border-radius:24px}
        .hero-copy h1{font-size:2.2rem}
        .hero-actions{display:grid;grid-template-columns:1fr;gap:10px}
        .hero-actions a{width:100%}
        .filter-glass{margin-left:-2px;margin-right:-2px;padding:12px;border-radius:20px}
        .filter-grid,.date-range{grid-template-columns:1fr;gap:9px}
        .filter-glass .form-control,.filter-glass .form-select{min-height:46px;font-size:.95rem}
        .filter-button{min-height:46px}
        .hero-stats{grid-template-columns:1fr}
        .section-title{margin-top:26px}
        .result-pill{align-self:flex-start}
    }
</style>

<section class="discover-hero">
    <div class="hero-copy">
        <div class="eyebrow">Keşfet</div>
        <h1>Bugün hangi etkinliğe karışıyoruz?</h1>
        <p>İlgi alanlarına, konumuna ve topluluğun hareketine göre yaklaşan etkinlikleri tek yerden keşfet.</p>
        <div class="hero-actions">
            <a class="btn-primary-modern" asp-controller="Event" asp-action="AddEvent">Etkinlik oluştur</a>
            <a class="ghost-button" asp-controller="Event" asp-action="Map">Haritada keşfet</a>
        </div>
    </div>
    <div class="hero-stats" aria-label="Etkinlik özeti">
        <div class="stat-card"><strong>@events.Count</strong><span>yaklaşan etkinlik</span></div>
        <div class="stat-card"><strong>@recommendations.Count</strong><span>önerilen etkinlik</span></div>
        <div class="stat-card"><strong>@nearby.Count</strong><span>yakındaki etkinlik</span></div>
        <div class="stat-card"><strong>@categories.Count()</strong><span>aktif kategori</span></div>
    </div>
</section>

@if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> }

<form class="filter-glass" method="get" aria-label="Etkinlik filtreleri">
    <div class="filter-grid">
        <input class="form-control" name="query" value="@ViewBag.Query" placeholder="Etkinlik, açıklama veya konum ara">
        <select class="form-select" name="categoryId"><option value="">Tüm kategoriler</option>@foreach (var category in categories) { <option value="@category.Id" selected="@(ViewBag.CategoryId == category.Id ? "selected" : null)">@category.Name</option> }</select>
        <div class="date-range"><input type="date" class="form-control" name="from" value="@ViewBag.From?.ToString("yyyy-MM-dd")" aria-label="Başlangıç"><input type="date" class="form-control" name="to" value="@ViewBag.To?.ToString("yyyy-MM-dd")" aria-label="Bitiş"></div>
        <button class="btn-primary-modern filter-button" type="submit">Filtrele</button>
    </div>
</form>

@if (recommendations.Any())
{
    <section>
        <div class="section-title"><div><h2>Sana özel öneriler</h2><p>İlgi alanların ve geçmiş katılımlarına göre seçildi.</p></div></div>
        <div class="event-grid">
            @foreach (var item in recommendations.Take(4))
            {
                <article class="event-card"><img class="event-card-image" src="@(item.ImageUrl ?? "/images/default-event.jpg")" alt="@item.Name"><div class="event-card-body"><h3>@item.Name</h3><div class="event-card-details"><div class="event-meta">◷ @item.Date.ToString("dd MMM yyyy, HH:mm")</div><div class="event-meta">⌖ @item.Location</div><div class="event-meta">♟ @item.Participants.Count katılımcı</div></div><a class="btn-primary-modern w-100" asp-controller="Event" asp-action="Details" asp-route-id="@item.Id">Detayları gör</a></div></article>
            }
        </div>
    </section>
}

@if (nearby.Any())
{
    <section>
        <div class="section-title"><div><h2>Yakınındaki etkinlikler</h2><p>Konumuna göre 50 km içindeki etkinlikler.</p></div><a class="ghost-button" asp-controller="Event" asp-action="Map">Haritada gör</a></div>
        <div class="event-grid">
            @foreach (var item in nearby.Take(4))
            {
                <article class="event-card"><img class="event-card-image" src="@(item.ImageUrl ?? "/images/default-event.jpg")" alt="@item.Name"><div class="event-card-body"><h3>@item.Name</h3><div class="event-card-details"><div class="event-meta">◷ @item.Date.ToString("dd MMM yyyy, HH:mm")</div><div class="event-meta">⌖ @item.Location</div></div><a class="btn-primary-modern w-100" asp-controller="Event" asp-action="Details" asp-route-id="@item.Id">Detayları gör</a></div></article>
            }
        </div>
    </section>
}

<section>
    <div class="section-title"><div><h2>Tüm etkinlikler</h2><p>Yaklaşan ve onaylanmış etkinlikler.</p></div><span class="result-pill">@events.Count sonuç</span></div>
    @if (events.Any())
    {
        <div class="event-grid">
            @foreach (var item in events)
            {
                <article class="event-card"><img class="event-card-image" src="@(item.ImageUrl ?? "/images/default-event.jpg")" alt="@item.Name"><div class="event-card-body"><h3>@item.Name</h3><div class="event-card-details"><div class="event-meta">◷ @item.Date.ToString("dd MMM yyyy, HH:mm")</div><div class="event-meta">⌖ @item.Location</div><div class="event-meta">♟ @item.Participants.Count katılımcı</div></div><a class="btn-primary-modern w-100" asp-controller="Event" asp-action="Details" asp-route-id="@item.Id">Detayları gör</a></div></article>
            }
        </div>
        @if ((int)ViewBag.TotalPages > 1)
        {
            <nav class="mt-4" aria-label="Etkinlik sayfaları"><div class="d-flex justify-content-center gap-2 flex-wrap">@for (var pageNumber = 1; pageNumber <= (int)ViewBag.TotalPages; pageNumber++) { <a class="btn @(pageNumber == (int)ViewBag.Page ? "btn-primary" : "btn-outline-secondary")" asp-route-page="@pageNumber" asp-route-query="@ViewBag.Query" asp-route-categoryId="@ViewBag.CategoryId">@pageNumber</a> }</div></nav>
        }
    }
    else
    {
        <div class="empty-state"><h3>Henüz uygun etkinlik yok</h3><p class="text-muted">Filtreleri değiştirin veya ilk etkinliği siz oluşturun.</p><a class="btn-primary-modern" asp-controller="Event" asp-action="AddEvent">Etkinlik oluştur</a></div>
    }
</section>
