@model Tuple<IEnumerable<WebApplication1.Models.Etkinlik>, IEnumerable<WebApplication1.Models.Etkinlik>>
@using WebApplication1.Models
@{
    ViewData["Title"] = "Etkinliklerim";
    Layout = "~/Views/Shared/UserLayout.cshtml";
    var createdEvents = Model.Item1 ?? Enumerable.Empty<Etkinlik>();
    var participatedEvents = Model.Item2 ?? Enumerable.Empty<Etkinlik>();
}

<div class="page-heading">
    <div>
        <div class="eyebrow" style="color:#635bff;font-size:.76rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase">Kişisel alanın</div>
        <h1>Etkinliklerim</h1>
        <p>Oluşturduğun ve katıldığın etkinlikleri tek yerde yönet. Topluluk alanına buradan tekrar dönebilirsin.</p>
    </div>
    <a class="btn-primary-modern" asp-controller="Event" asp-action="AddEvent">＋ Yeni etkinlik</a>
</div>

<div class="d-flex gap-2 mb-4">
    <button class="btn btn-dark" type="button" data-list-tab="created">Oluşturduklarım <span class="badge text-bg-light">@createdEvents.Count()</span></button>
    <button class="btn btn-outline-dark" type="button" data-list-tab="participated">Katıldıklarım <span class="badge text-bg-light">@participatedEvents.Count()</span></button>
</div>

<section data-list-panel="created">
    <div class="event-grid">
        @foreach (var item in createdEvents)
        {
            <article class="event-card">
                <img class="event-card-image" src="@(item.ImageUrl ?? "/images/default-event.jpg")" alt="@item.Name">
                <div class="event-card-body">
                    <div class="d-flex justify-content-between gap-2">
                        <h3>@item.Name</h3>
                        <span class="badge @(item.Status == EventStatus.Approved ? "text-bg-success" : item.Status == EventStatus.Cancelled ? "text-bg-secondary" : "text-bg-warning")">@item.Status</span>
                    </div>
                    <div class="event-meta">◷ @item.Date.ToString("dd MMM yyyy, HH:mm")</div>
                    <div class="event-meta">♟ @item.Participants.Count katılımcı</div>
                    <div class="d-flex gap-2 mt-3 flex-wrap">
                        <a class="btn btn-sm btn-outline-primary" asp-controller="Event" asp-action="UpdateEvent" asp-route-id="@item.Id">Düzenle</a>
                        <a class="btn btn-sm btn-outline-success" asp-controller="Event" asp-action="Community" asp-route-id="@item.Id">Topluluk</a>
                        @if (item.Status is not EventStatus.Completed and not EventStatus.Cancelled)
                        {
                            <form asp-controller="Event" asp-action="CancelEvent" method="post">
                                <input type="hidden" name="id" value="@item.Id">
                                <button class="btn btn-sm btn-outline-danger" type="submit">İptal et</button>
                            </form>
                        }
                    </div>
                </div>
            </article>
        }
    </div>
    @if (!createdEvents.Any())
    {
        <div class="surface p-5 text-center">
            <h3>Henüz etkinlik oluşturmadın</h3>
            <a class="btn-primary-modern mt-2" asp-controller="Event" asp-action="AddEvent">İlk etkinliğini oluştur</a>
        </div>
    }
</section>

<section data-list-panel="participated" style="display:none">
    <div class="event-grid">
        @foreach (var item in participatedEvents)
        {
            <article class="event-card">
                <img class="event-card-image" src="@(item.ImageUrl ?? "/images/default-event.jpg")" alt="@item.Name">
                <div class="event-card-body">
                    <h3>@item.Name</h3>
                    <div class="event-meta">◷ @item.Date.ToString("dd MMM yyyy, HH:mm")</div>
                    <div class="event-meta">⌖ @item.Location</div>
                    <div class="d-grid gap-2 mt-3">
                        <a class="btn-primary-modern w-100" asp-controller="Event" asp-action="Community" asp-route-id="@item.Id">Topluluğa git</a>
                        <a class="btn btn-outline-primary w-100" asp-controller="Event" asp-action="Details" asp-route-id="@item.Id">Detayları gör</a>
                    </div>
                </div>
            </article>
        }
    </div>
    @if (!participatedEvents.Any())
    {
        <div class="surface p-5 text-center">
            <h3>Henüz bir etkinliğe katılmadın</h3>
            <a class="btn-primary-modern mt-2" asp-controller="User" asp-action="Index">Etkinlikleri keşfet</a>
        </div>
    }
</section>

@section Scripts {
    <script>
        document.querySelectorAll('[data-list-tab]').forEach(function (tab) {
            tab.addEventListener('click', function () {
                document.querySelectorAll('[data-list-tab]').forEach(function (item) {
                    item.classList.toggle('btn-dark', item === tab);
                    item.classList.toggle('btn-outline-dark', item !== tab);
                });
                document.querySelectorAll('[data-list-panel]').forEach(function (panel) {
                    panel.style.display = panel.dataset.listPanel === tab.dataset.listTab ? 'block' : 'none';
                });
            });
        });
    </script>
}
