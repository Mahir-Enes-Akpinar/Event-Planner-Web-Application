@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Sıralama";
    Layout = "~/Views/Shared/UserLayout.cshtml";
    var users = Model?.ToList() ?? new List<dynamic>();
    var rank = 1;
}
<style>
    .leaderboard-hero{display:grid;grid-template-columns:1fr auto;gap:24px;align-items:end;margin-bottom:24px;padding:28px;border:1px solid rgba(255,255,255,.72);border-radius:28px;background:linear-gradient(135deg,rgba(255,255,255,.72),rgba(255,255,255,.38));box-shadow:0 24px 60px rgba(51,35,114,.12);backdrop-filter:blur(20px)}
    .leaderboard-hero h1{margin:0;font-weight:850;letter-spacing:-.04em}
    .leaderboard-hero p{margin:8px 0 0;color:var(--muted)}
    .score-chip{padding:12px 16px;border-radius:18px;color:#fff;background:linear-gradient(135deg,var(--primary),var(--accent));box-shadow:0 14px 30px rgba(109,93,252,.22);font-weight:800}
    .leaderboard-list{display:grid;gap:12px}
    .rank-row{display:grid;grid-template-columns:58px 1fr auto;gap:16px;align-items:center;padding:16px;border:1px solid rgba(255,255,255,.78);border-radius:20px;background:rgba(255,255,255,.68);box-shadow:0 16px 36px rgba(51,35,114,.08);backdrop-filter:blur(18px)}
    .rank-number{display:grid;place-items:center;width:46px;height:46px;border-radius:16px;color:#fff;background:#151b2d;font-weight:850}
    .rank-row:nth-child(1) .rank-number{background:linear-gradient(135deg,#ffb703,#ff6b6b)}
    .rank-row:nth-child(2) .rank-number{background:linear-gradient(135deg,#0fb9b1,#6d5dfc)}
    .rank-row:nth-child(3) .rank-number{background:linear-gradient(135deg,#8b5cf6,#ff6b6b)}
    .rank-user{font-weight:800;color:var(--navy)}
    .rank-sub{color:var(--muted);font-size:.86rem}
    .rank-score{min-width:110px;text-align:center;padding:10px 14px;border-radius:16px;background:#fff7ed;color:#e11d48;font-weight:850}
    .empty-board{padding:42px;text-align:center;border-radius:24px;background:rgba(255,255,255,.68);backdrop-filter:blur(18px)}
    @@media(max-width:720px){.leaderboard-hero{grid-template-columns:1fr}.rank-row{grid-template-columns:48px 1fr}.rank-score{grid-column:2;text-align:left}}
</style>
<section class="leaderboard-hero">
    <div>
        <div class="eyebrow">Topluluk</div>
        <h1>Puan sıralaması</h1>
        <p>Etkinliklere katılım ve katkılara göre en aktif kullanıcılar.</p>
    </div>
    <div class="score-chip">@users.Count kullanıcı</div>
</section>

@if (users.Any())
{
    <section class="leaderboard-list" aria-label="Puan sıralaması">
        @foreach (var user in users)
        {
            <article class="rank-row">
                <div class="rank-number">@rank</div>
                <div>
                    <div class="rank-user">@user.Kullanici.UserName</div>
                    <div class="rank-sub">Topluluk puanı</div>
                </div>
                <div class="rank-score">@user.TotalScore puan</div>
            </article>
            rank++;
        }
    </section>
}
else
{
    <div class="empty-board">
        <h2 class="h4">Henüz sıralama oluşmadı</h2>
        <p class="text-muted mb-0">Etkinliklere katılım başladığında puanlar burada görünecek.</p>
    </div>
}
